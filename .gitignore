# Loja Leonet - .gitignore (raiz)
# Objetivo: evitar subir para o git arquivos locais, caches, builds e dados sensíveis.

############################
# Requisitos do projeto
############################
# Ambientes virtuais Python
venv/
.venv/
env/
ENV/

# Banco de dados local (SQLite)
db.sqlite3
**/db.sqlite3
*.sqlite3
*.sqlite3-journal

# Documentação
# Arquivos .md em docs/ DEVEM ir para o git.
# Anexos pesados (pdf/imagens/vídeos/etc) já são ignorados pelas regras de extensão abaixo.

# Pastas locais de documentos e vídeos (não versionar)
documentos/
videos/
Documentos/
Videos/

# Arquivos comuns de documentos/mídia (em qualquer pasta)
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
*.csv
*.zip
*.rar
*.7z
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Docs: arquivos de apoio/sensíveis (não versionar)
docs/**/*.txt
docs/**/usuarios.txt

############################
# Python
############################
__pycache__/
*.py[cod]
*$py.class

# Distribuição / build
build/
dist/
*.egg-info/
.eggs/

# Ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

############################
# Node / Next.js
############################
node_modules/
.pnp
.pnp.*

.next/
out/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

############################
# OS / Editor
############################
.DS_Store
Thumbs.db
Desktop.ini

.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

############################
# Secrets / env
############################
.env
.env.*

# Chaves/certificados
*.pem
*.key
*.crt

############################
# Docker
############################
*.log
